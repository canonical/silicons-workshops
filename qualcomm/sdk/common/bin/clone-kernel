#!/usr/bin/bash
# clone-kernel — Qualcomm Silicon Workshop
#
# Clones (or updates) the configured kernel repository into kernel-src/ and
# checks out the configured revision. This is a SEPARATE step from building:
# run it once, then run kernel-build-debs / kernel-build-snap as many times as
# you like without re-cloning.
#
# What to clone (repository + ref) comes from config/workshop.yaml.
#
# Usage:
#   clone-kernel [--config PATH]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_DIR="${SCRIPT_DIR}/.."

export WORKSHOP_LOG_TAG="clone-kernel"
# shellcheck source=/dev/null
source "${COMMON_DIR}/workshop.sh"
# shellcheck source=/dev/null
source "${COMMON_DIR}/source.sh"

CONFIG_PATH=""
while [[ $# -gt 0 ]]; do
    case "${1}" in
        --config)   CONFIG_PATH="${2}"; shift 2 ;;
        --config=*) CONFIG_PATH="${1#--config=}"; shift ;;
        --help|-h)
            cat <<'HELP'
clone-kernel — clone the configured kernel source into kernel-src/.

Usage:
  clone-kernel [--config PATH]

Reads kernel.repository and kernel.ref from config/workshop.yaml.
Re-running updates the existing kernel-src (git fetch + checkout).
To start completely fresh: rm -rf kernel-src && clone-kernel
HELP
            exit 0 ;;
        *) echo "Unknown option: ${1} (see clone-kernel --help)" >&2; exit 1 ;;
    esac
done

WORKSHOP_ROOT="$(workshop_find_root)"
workshop_log "Workshop root: ${WORKSHOP_ROOT}"
if [[ -n "${CONFIG_PATH}" ]]; then
    [[ -f "${CONFIG_PATH}" ]] || workshop_fail "Config file not found: ${CONFIG_PATH}"
fi
workshop_read_config "${WORKSHOP_ROOT}"
workshop_validate_config

RESOLVED_SHA="$(workshop_clone_source \
    "${WORKSHOP_ROOT}" "${CFG_KERNEL_REPOSITORY}" \
    "${CFG_KERNEL_REF_TYPE}" "${CFG_KERNEL_REF_VALUE}")"

workshop_log ""
workshop_log "clone-kernel done."
workshop_log "  Repo:   ${CFG_KERNEL_REPOSITORY}"
workshop_log "  Ref:    ${CFG_KERNEL_REF_TYPE}:${CFG_KERNEL_REF_VALUE}"
workshop_log "  Commit: ${RESOLVED_SHA}"
workshop_log "  Tree:   kernel-src/"
workshop_log ""
workshop_log "Next: workshop run -- kernel-build-debs   (or kernel-build-snap)"
