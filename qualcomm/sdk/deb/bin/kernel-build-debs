#!/usr/bin/bash
# kernel-build-debs — Qualcomm Silicon Workshop Debian Packaging SDK
#
# Self-contained: builds Ubuntu kernel Debian packages directly from source.
#
#   read configuration (config/workshop.yaml)
#       ↓ validate configuration / environment
#       ↓ require kernel source (clone-kernel must have run)
#       ↓ apply configured patches
#       ↓ mrproper + debian/rules clean (pristine out-of-tree build)
#       ↓ drop zfs DKMS + annotate board kconfig + updateconfigs
#       ↓ dpkg-buildpackage (tree's own debian/rules; it owns kernel config)
#       ↓ stage .debs → out/deb/
#       ↓ validate packages
#       ↓ success
#
# Usage:
#   kernel-build-debs [--config PATH]
#
# Environment:
#   SKIP_CLEAN=1        skip the initial mrproper + debian/rules clean
#   SKIP_CHOWN=1        skip the pre-build ownership reset
#   SKIP_BUILD_DEPS=1   skip apt-get build-dep
#   BUILDPACKAGE_OPTS   extra flags for dpkg-buildpackage (e.g. "-j8")
#   WORKSHOP_ARCH       override toolchain.arch
#   WORKSHOP_JOBS       override build parallelism (default: half the cores)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/../lib"
COMMON_DIR="${SCRIPT_DIR}/../../common"

export WORKSHOP_LOG_TAG="deb-sdk"
# shellcheck source=/dev/null
source "${COMMON_DIR}/workshop.sh"
# shellcheck source=/dev/null
source "${COMMON_DIR}/source.sh"
for lib in package validate; do
    # shellcheck source=/dev/null
    source "${LIB_DIR}/${lib}.sh"
done

CONFIG_PATH=""
while [[ $# -gt 0 ]]; do
    case "${1}" in
        --config)   CONFIG_PATH="${2}"; shift 2 ;;
        --config=*) CONFIG_PATH="${1#--config=}"; shift ;;
        --help|-h)
            cat <<'HELP'
kernel-build-debs — build Ubuntu kernel Debian packages from source.

Usage:
  kernel-build-debs [--config PATH]

Output:
  out/deb/*.deb
  out/deb/metadata/

Environment:
  SKIP_CLEAN, SKIP_CHOWN, SKIP_BUILD_DEPS, BUILDPACKAGE_OPTS, WORKSHOP_ARCH, WORKSHOP_JOBS
HELP
            exit 0 ;;
        *) echo "Unknown option: ${1} (see kernel-build-debs --help)" >&2; exit 1 ;;
    esac
done

WORKSHOP_ROOT="$(workshop_find_root)"
workshop_log "Workshop root: ${WORKSHOP_ROOT}"
if [[ -n "${CONFIG_PATH}" ]]; then
    [[ -f "${CONFIG_PATH}" ]] || workshop_fail "Config file not found: ${CONFIG_PATH}"
fi
workshop_read_config "${WORKSHOP_ROOT}"
workshop_validate_config
workshop_resolve_toolchain

# --- source (must already be cloned: run clone-kernel first) ----------------
RESOLVED_SHA="$(workshop_require_source "${WORKSHOP_ROOT}")"
workshop_log "Using kernel-src at commit: ${RESOLVED_SHA}"
workshop_apply_patches "${WORKSHOP_ROOT}" "${CFG_PATCHES:-}"

# --- build / stage / validate ----------------------------------------------
deb_build    "${WORKSHOP_ROOT}" "${KERNEL_ARCH}"
deb_stage    "${WORKSHOP_ROOT}"
deb_validate "${WORKSHOP_ROOT}" "${KERNEL_ARCH}"

workshop_log ""
workshop_log "════════════════════════════════════════════════════════════════"
workshop_log "kernel-build-debs succeeded"
workshop_log "  Commit:   ${RESOLVED_SHA}"
workshop_log "  Packages: out/deb/*.deb"
workshop_log "  Metadata: out/deb/metadata/"
workshop_log "════════════════════════════════════════════════════════════════"
