# Canonical / Ubuntu Core (snapd) kconfig fragment — Goal 2 required kit file.
#
# The kernel options snapd + Ubuntu Core need for confinement and snap mounting:
# control groups, namespaces, AppArmor, seccomp, squashfs, overlayfs.
# This is the "Can. Kconf (snapd)" box on the design whiteboard. It is a board-
# AGNOSTIC fragment (same for any Qualcomm board targeting Ubuntu Core), shipped
# here under rubikpi3 as the worked example.

# --- namespaces ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- control groups ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y

# --- seccomp (snap sandbox syscall filtering) ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- AppArmor (snapd confinement; must be the default LSM on Ubuntu) ---
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y

# --- squashfs (snaps are squashfs images) ---
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y

# --- overlayfs + base filesystems Ubuntu Core relies on ---
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- snapd uses these for refresh/quota/health ---
CONFIG_FANOTIFY=y
CONFIG_FHANDLE=y
