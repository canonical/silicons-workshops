# Customer kconfig fragment — Goal 2 required kit file.
#
# The customer's board-specific kernel deltas, merged on top of the board
# defconfig + the Canonical snapd fragment. This is the "Cust. Kconf" box on the
# design whiteboard. The values below are EXAMPLES for Rubik Pi 3 — replace with
# the real customer's required options.

# --- example: extra peripheral support a customer might require ---
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_ACM=m

# --- example: enable CAN bus stack as modules ---
CONFIG_CAN=m
CONFIG_CAN_RAW=m

# --- example: a customer explicitly turning an option OFF ---
# (merge_config / annotations will honour the "is not set" form)
# CONFIG_DEBUG_INFO_REDUCED is not set
